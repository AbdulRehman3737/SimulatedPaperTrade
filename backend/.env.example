PORT=4000

# Optional CoinGecko Demo API key. Not required for normal use (Binance is the
# primary data source, CoinGecko is only a fallback), but setting it raises
# the fallback's rate limit if you have one.
COINGECKO_API_KEY=

# How often the bot loop runs, in minutes
BOT_INTERVAL_MINUTES=5

# Set to "false" to disable auto-starting the bot when the server boots
BOT_AUTOSTART=true

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
