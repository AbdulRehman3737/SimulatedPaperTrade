# Example Nginx reverse proxy for a DigitalOcean Droplet.
# Copy to /etc/nginx/sites-available/crypto-paper-trading-bot,
# symlink into sites-enabled, then `nginx -t && systemctl reload nginx`.
#
# The Node process (PM2, see backend/ecosystem.config.js) already serves
# both the API and the built frontend on PORT (default 4000), so Nginx
# here only handles the public-facing port 80/443, TLS, and proxying.

server {
    listen 80;
    server_name your-domain.example.com;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# After this is working, run `certbot --nginx -d your-domain.example.com`
# to get a free TLS certificate and have Certbot add the HTTPS server block.
